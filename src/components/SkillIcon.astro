---
import CustomIcon from "@components/CustomIcon.astro";

interface Props {
  name: string;
  description: string;
}

const { name, description } = Astro.props;
---

<div class="skill-icon">
  <CustomIcon
    class="skill-icon__icon"
    name={name}
    label={description}
    width="32"
    height="32"
  />
  <p class="skill-icon__description">{description}</p>
</div>
<style>
  .skill-icon {
    width: 45%;
    min-width: 140px;
    height: auto;
    display: flex;
    justify-content: start;
    align-items: center;
    gap: 8px;

    .skill-icon__description {
      margin: 0;
      color: var(--tertiary-color);
    }
  }
</style>
