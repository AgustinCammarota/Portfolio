---
import CustomIcon from "@components/CustomIcon.astro";
import type { Geometry } from "@interfaces/geometry.interface";

interface Props {
  isAbsolute?: boolean;
}

const { isAbsolute = false } = Astro.props;

const geometries: Geometry[] = [
  {
    icon: "geometry",
    title: "Geometry",
    size: "140",
  },
  {
    icon: "dots",
    title: "Dots",
    size: "100",
  },
  {
    icon: "rectangle",
    title: "Rectangle",
    size: "120",
  },
].sort(() => Math.random() - 0.5);
---

<div class:list={["geometry", { absolute: isAbsolute }]} aria-hidden="true">
  {
    geometries.map(({ icon, size, title }, index) => (
      <div class={`geometry-icon icon-${index + 1}`} aria-label={title}>
        <CustomIcon name={icon} label={title} width={size} height={size} />
      </div>
    ))
  }
</div>
<style>
  .geometry {
    width: 100%;
    height: 100%;
  }
  .absolute {
    position: absolute;
  }
  .geometry-icon {
    width: 100%;
    height: auto;
    display: flex;
    align-items: center;
  }
  .icon-1 {
    justify-content: start;
  }
  .icon-2 {
    justify-content: end;
  }
  .icon-3 {
    justify-content: start;
  }
</style>
