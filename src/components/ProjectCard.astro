---
import { ProjectVideo } from "@islands/project-video/ProjectVideo";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import CustomImage from "@components/CustomImage.astro";
import Forward from "@icons/forward.svg";
import DoubleArrow from "@icons/double-arrow.svg";

interface Props {
  image: string;
  alt: string;
  video: string;
  title: string;
  technologies: string;
  hasLink: boolean;
  hasWebsite: boolean;
  github?: string;
  website?: string;
}

const {
  image,
  alt,
  video,
  title,
  technologies,
  hasLink,
  github,
  hasWebsite,
  website,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="project-card">
  <ProjectVideo client:load video={video}>
    <CustomImage
      quality="mid"
      loading="eager"
      className="image"
      imagePath={image}
      altText={alt}
      height={200}
      width={400}
    />
  </ProjectVideo>
  <p class="card-technologies">{technologies}</p>

  <div class="card-body">
    <h3 class="card-body__title">{title}</h3>
    <div class="card-body-description">
      <slot name="description" />
    </div>
    <div class="card-body-links">
      {
        hasLink && (
          <a
            id="cardBodyLinkRepository"
            class="card-body__link"
            href={github}
            data-name="repository"
            title={t("project.card.github.title")}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>{t("project.card.github.link")}</span>
            <Forward
              aria-label="forward"
              width="28"
              height="18"
              fill="currentColor"
            />
          </a>
        )
      }
      {
        hasWebsite && (
          <a
            id="cardBodyLinkWebsite"
            class="card-body__link card-body__link--gray"
            data-name="website"
            href={website}
            title={t("project.card.website.title")}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>{t("project.card.website.link")}</span>
            <DoubleArrow
              aria-label="Double Arrow"
              width="18"
              height="18"
              fill="currentColor"
            />
          </a>
        )
      }
    </div>
  </div>
</div>
<style>
  .project-card {
    width: 100%;
    max-width: 400px;
    min-width: 300px;
    height: max-content;
    position: relative;
    border: 1px solid var(--primary-color);
  }
  .card-technologies {
    margin: 0;
    padding: 8px;
    border-bottom: 1px solid var(--primary-color);
    border-top: 1px solid var(--primary-color);
    color: var(--primary-color);
    text-wrap: wrap;
    font-weight: 400;
    font-size: var(--fs-sm);
  }
  .card-body {
    width: 100%;
    height: auto;
    padding: 16px;

    .card-body__title {
      margin: 0;
      color: var(--secondary-color);
      font-weight: 400;
      text-wrap: balance;
    }
    .card-body-description p,
    .card-body-description strong {
      margin-bottom: 0;
      margin-top: 12px;
      color: var(--tertiary-color);
      text-wrap: balance;
      font-size: 1.8rem;
    }
  }
  .card-body-links {
    width: 100%;
    height: auto;
    display: flex;
    justify-content: start;
    align-items: center;
    gap: 18px;

    .card-body__link {
      width: max-content;
      height: 40px;
      margin-top: 16px;
      padding: 8px 16px;
      display: flex;
      justify-content: center;
      align-items: center;
      border: 1px solid var(--primary-color);
      color: var(--primary-color);
      font-weight: 500;

      span {
        margin-right: 4px;
      }
    }
    .card-body__link:hover {
      border: 1px solid var(--secondary-color);
      color: var(--secondary-color);
    }
    .card-body__link--gray {
      border: 1px solid var(--tertiary-color);
      color: var(--tertiary-color);
    }
  }
</style>
<script>
  document.addEventListener("astro:page-load", addEventListenerElements);

  function addEventListenerElements() {
    addEventListenerCardBodyLinkRepository();
    addEventListenerCardBodyLinkWebsite();
  }

  function addEventListenerCardBodyLinkRepository() {
    const links = document.querySelectorAll<HTMLAnchorElement>(
      "#cardBodyLinkRepository",
    );
    if (links && links.length) {
      links.forEach((link) => {
        link.addEventListener("click", (event: MouseEvent) => {
          const target = event.target as HTMLElement;
          const element = target.closest(
            "#cardBodyLinkRepository",
          ) as HTMLAnchorElement;
          sendAnalyticsEvent("repository_link_click", {
            interaction_name: element.dataset.name || "",
            link_url: element.href,
          });
        });
      });
    }
  }

  function addEventListenerCardBodyLinkWebsite() {
    const links = document.querySelectorAll<HTMLAnchorElement>(
      "#cardBodyLinkWebsite",
    );
    if (links && links.length) {
      links.forEach((link) => {
        link.addEventListener("click", (event: MouseEvent) => {
          const target = event.target as HTMLElement;
          const element = target.closest(
            "#cardBodyLinkWebsite",
          ) as HTMLAnchorElement;
          sendAnalyticsEvent("website_link_click", {
            interaction_name: element.dataset.name || "",
            link_url: element.href,
          });
        });
      });
    }
  }

  function sendAnalyticsEvent(eventName: string, data: unknown) {
    window.gtag("event", eventName, data);
  }
</script>
