---
import CustomIcon from "@components/CustomIcon.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import type { Nav } from "@interfaces/nav.interface";

const currentPath: string = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems: Nav[] = [
  {
    name: t("nav.home"),
    link: "/",
    icon: "house",
  },
  {
    name: t("nav.works"),
    link: "works",
    icon: "briefcase",
  },
  {
    name: t("nav.skills"),
    link: "skills",
    icon: "gear",
  },
  {
    name: t("nav.projects"),
    link: "projects",
    icon: "project",
  },
  {
    name: t("nav.contact"),
    link: "contact",
    icon: "contact",
  },
];
---

<nav class="navbar">
  <ul class="list-container">
    {
      navItems.map((item: Nav) => (
        <li class="list-item">
          <a
            class:list={[
              "list-item__link",
              {
                "list-item__link--active":
                  currentPath === getRelativeLocaleUrl(lang, item.link),
              },
            ]}
            title={item.name}
            href={getRelativeLocaleUrl(lang, item.link)}
            data-astro-prefetch="tap"
          >
            <CustomIcon
              name={item.icon}
              label={item.name}
              width="24"
              height="24"
            />
            <span>{item.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<style>
  .navbar {
    width: 100%;
    height: 85px;
    padding-top: 8px;
    align-content: center;
    border-top: 1px solid var(--tertiary-color);
    background-color: var(--background-color);
  }
  .list-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: center;
  }
  .list-item {
    min-width: 20%;
    .list-item__link {
      display: flex;
      flex-direction: column;
      justify-content: space-around;
      align-items: center;
      row-gap: 6px;
      font-size: var(--fs-sm);
      font-weight: 500;
      color: var(--tertiary-color);
    }
    .list-item__link--active,
    .list-item__link:hover {
      color: var(--secondary-color);
    }
    .list-item__link--active::before,
    .list-item__link:hover::before {
      content: "";
      background: var(--primary-color);
      position: absolute;
      width: 20%;
      height: 3px;
      top: 0;
    }
  }
  /* @media */
  @media (min-width: 600px) {
    .list-item__link {
      font-size: var(--fs-base);
    }
  }
  @media (min-width: 900px) {
    .navbar {
      height: 90px;
    }
    .list-item {
      svg {
        width: 28px;
        height: 28px;
      }
      .list-item__link {
        row-gap: 8px;
        font-size: var(--fs-base);
      }
    }
  }
</style>
