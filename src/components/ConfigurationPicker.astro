---
import CustomIcon from "@components/CustomIcon.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { ROUTES } from "@i18n/ui";
import { SelectLanguage } from "@islands/select-language/SelectLanguage";
import { ThemeManager } from "@islands/theme-manager/ThemeManager";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentLang = getLangFromUrl(Astro.url);
const currentPath: string = Astro.url.pathname;

const links: string[] = ROUTES;
const currentLink: string = currentPath
  .split("/")
  .filter((path) => links.includes(path))[0];
---

<section class="configuration-picker-section">
  <ThemeManager
    client:only="solid-js"
    ariaLabel={t("theme.manager.aria.label")}
  >
    <CustomIcon
      slot="iconDark"
      class="theme-icon"
      name="dark-mode"
      label="Dark Mode"
      width="24"
      height="24"
    />
    <CustomIcon
      slot="iconLight"
      class="theme-icon"
      name="light-mode"
      label="Light Mode"
      width="24"
      height="24"
    />
  </ThemeManager>
  <SelectLanguage
    client:idle
    datepickerLabel={t("datepicker.label")}
    currentLang={currentLang}
    currentLink={currentLink}
  >
    <CustomIcon
      slot="iconLeft"
      class="language-icon"
      name="language"
      label="Language"
      width="24"
      height="24"
    />
    <CustomIcon
      slot="iconRight"
      class="language-icon small-icon"
      name="arrow"
      label="Arrow"
      width="18"
      height="18"
    />
  </SelectLanguage>
</section>
<style>
  .configuration-picker-section {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  /* @media */
  @media (min-width: 900px) {
    .configuration-picker-section {
      gap: 16px;
      color: var(--tertiary-color);
      .language-icon,
      .theme-icon {
        svg {
          width: 32px;
          height: 32px;
        }
      }
      .small-icon {
        svg {
          width: 21px;
          height: 21px;
        }
      }
    }
  }
</style>
